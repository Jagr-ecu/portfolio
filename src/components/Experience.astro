---
import { experiencia, educacion, idiomas } from '../data/portfolio';
---

<section id="experiencia" class="exp-section">
  <div class="container">
    <h2 class="section-title reveal">Experiencia y <span class="accent">formación</span></h2>

    <div class="cols">
      <div class="timeline">
        {
          experiencia.map((e) => (
            <div class="item reveal">
              <div class="dot" />
              <div class="body">
                <span class="periodo">{e.periodo}</span>
                <h3>{e.puesto}</h3>
                <p class="empresa">{e.empresa} · {e.ubicacion}</p>
                <ul>
                  {e.logros.map((l) => (
                    <li>{l}</li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>

      <aside class="side">
        <div class="box reveal">
          <h4>🎓 Educación</h4>
          {
            educacion.map((ed) => (
              <div class="edu">
                <strong>{ed.titulo}</strong>
                <span>{ed.institucion}</span>
                <span class="faint">{ed.periodo}</span>
              </div>
            ))
          }
        </div>
        <div class="box reveal">
          <h4>🌐 Idiomas</h4>
          {
            idiomas.map((i) => (
              <div class="idioma">
                <span>{i.idioma}</span>
                <span class="badge">{i.nivel}</span>
              </div>
            ))
          }
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .exp-section {
    background: var(--bg-soft);
  }
  .cols {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: 2.5rem;
    margin-top: 1.5rem;
  }
  .timeline {
    position: relative;
    padding-left: 1.5rem;
    border-left: 2px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .item {
    position: relative;
  }
  .dot {
    position: absolute;
    left: calc(-1.5rem - 7px);
    top: 6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--gradient);
    box-shadow: 0 0 0 4px var(--bg-soft);
  }
  .periodo {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent);
  }
  .body h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin-top: 0.2rem;
  }
  .empresa {
    color: var(--text-soft);
    font-size: 0.92rem;
    margin-bottom: 0.7rem;
  }
  .body ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .body li {
    position: relative;
    padding-left: 1.2rem;
    font-size: 0.9rem;
    color: var(--text-soft);
  }
  .body li::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: var(--accent);
  }
  .side {
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
  }
  .box {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 1.4rem 1.5rem;
    box-shadow: var(--shadow);
  }
  .box h4 {
    font-size: 1.05rem;
    margin-bottom: 1rem;
  }
  .edu {
    display: flex;
    flex-direction: column;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
  }
  .edu:last-child {
    border-bottom: none;
  }
  .edu strong {
    font-size: 0.95rem;
  }
  .edu span {
    font-size: 0.85rem;
    color: var(--text-soft);
  }
  .edu .faint {
    color: var(--text-faint);
  }
  .idioma {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
  }
  .badge {
    font-size: 0.78rem;
    font-weight: 600;
    color: #fff;
    background: var(--gradient);
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
  }
  @media (max-width: 820px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
