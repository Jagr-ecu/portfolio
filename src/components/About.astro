---
import { perfil, experiencia } from '../data/portfolio';

const anios = 4;
const stats = [
  { valor: `${anios}+`, label: 'Años de experiencia' },
  { valor: `${experiencia.length}`, label: 'Empresas' },
  { valor: '2', label: 'Idiomas' },
];
---

<section id="sobre-mi">
  <div class="container">
    <h2 class="section-title reveal">Sobre <span class="accent">mí</span></h2>
    <div class="grid">
      <p class="bio reveal">{perfil.resumen}</p>
      <div class="stats reveal">
        {
          stats.map((s) => (
            <div class="stat">
              <span class="num">{s.valor}</span>
              <span class="lbl">{s.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .bio {
    font-size: 1.1rem;
    color: var(--text-soft);
  }
  .stats {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .stat {
    padding: 1.3rem 1.5rem;
    border-radius: 16px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }
  .num {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .lbl {
    color: var(--text-faint);
    font-size: 0.9rem;
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .stats {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .stat {
      flex: 1;
      min-width: 130px;
    }
  }
</style>
