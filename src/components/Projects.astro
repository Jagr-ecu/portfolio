---
import { proyectos } from '../data/portfolio';
---

<section id="proyectos">
  <div class="container">
    <h2 class="section-title reveal">Mis <span class="accent">proyectos</span></h2>
    <p class="section-subtitle reveal">
      Selección de proyectos personales. Las capturas de cada funcionalidad se irán añadiendo.
    </p>

    <div class="list">
      {
        proyectos.map((p, i) => (
          <article class={`proj reveal ${i % 2 === 1 ? 'flip' : ''}`}>
            <div class="media">
              {p.imagenes.length === 0 ? (
                <div class="placeholder">
                  <span class="ph-ico">🖼️</span>
                  <span class="ph-txt">Capturas próximamente</span>
                  <span class="ph-sub">{p.titulo}</span>
                </div>
              ) : (
                <img src={p.imagenes[0]} alt={`Captura de ${p.titulo}`} />
              )}
            </div>

            <div class="info">
              <span class="tipo">{p.tipo}</span>
              <h3>{p.titulo}</h3>
              <p class="desc">{p.descripcion}</p>

              <ul class="destacados">
                {p.destacados.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>

              <div class="tags">
                {p.tecnologias.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>

              <div class="acciones">
                <a href={p.repo} target="_blank" rel="noopener" class="btn-link primary">
                  Ver código →
                </a>
                {p.demo && (
                  <a href={p.demo} target="_blank" rel="noopener" class="btn-link">
                    Demo en vivo ↗
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .proj {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 1.5rem;
    box-shadow: var(--shadow);
  }
  .proj.flip .media {
    order: 2;
  }
  .media {
    aspect-ratio: 16 / 10;
    border-radius: 16px;
    overflow: hidden;
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.4rem;
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 18%, var(--bg-soft)), color-mix(in srgb, var(--accent-3) 18%, var(--bg-soft)));
    border: 2px dashed var(--border);
  }
  .ph-ico {
    font-size: 2.4rem;
  }
  .ph-txt {
    font-weight: 600;
    color: var(--text-soft);
  }
  .ph-sub {
    font-size: 0.85rem;
    color: var(--text-faint);
  }
  .tipo {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    margin-bottom: 0.7rem;
  }
  h3 {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 0.6rem;
  }
  .desc {
    color: var(--text-soft);
    margin-bottom: 1rem;
  }
  .destacados {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.1rem;
  }
  .destacados li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 0.92rem;
    color: var(--text-soft);
  }
  .destacados li::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.3rem;
  }
  .tag {
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.3rem 0.7rem;
    border-radius: 8px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    color: var(--text-soft);
  }
  .acciones {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
  .btn-link {
    font-weight: 600;
    padding: 0.6rem 1.2rem;
    border-radius: 12px;
    border: 1px solid var(--border);
    transition: transform 0.15s, border-color 0.2s;
  }
  .btn-link.primary {
    color: #fff;
    background: var(--gradient);
    border: none;
  }
  .btn-link:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }

  @media (max-width: 820px) {
    .proj {
      grid-template-columns: 1fr;
    }
    .proj.flip .media {
      order: 0;
    }
  }
</style>
