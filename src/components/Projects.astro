---
import { proyectos } from '../data/portfolio';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (src: string) => `${base}/${src}`;

// Datos para el lightbox: una galería por proyecto (con URLs ya resueltas)
const galerias = Object.fromEntries(
  proyectos.map((p) => [p.slug, p.imagenes.map((i) => ({ src: url(i.src), caption: i.caption }))])
);
---

<section id="proyectos">
  <div class="container">
    <h2 class="section-title reveal">Mis <span class="accent">proyectos</span></h2>
    <p class="section-subtitle reveal">
      Selección de proyectos personales. Haz clic en cualquier imagen para verla en grande.
    </p>

    <div class="list">
      {
        proyectos.map((p, i) => (
          <article class={`proj reveal ${i % 2 === 1 ? 'flip' : ''}`}>
            <div class="gallery">
              {p.imagenes.length === 0 ? (
                <div class="placeholder">
                  <span class="ph-ico">🖼️</span>
                  <span class="ph-txt">Capturas próximamente</span>
                </div>
              ) : (
                <>
                  <button
                    class="cover"
                    data-gallery={p.slug}
                    data-index="0"
                    aria-label={`Ver ${p.titulo} en grande`}
                  >
                    <img src={url(p.imagenes[0].src)} alt={p.imagenes[0].caption} loading="lazy" />
                    <span class="cover-cap">{p.imagenes[0].caption}</span>
                  </button>
                  {p.imagenes.length > 1 && (
                    <div class="thumbs">
                      {p.imagenes.slice(1).map((img, idx) => (
                        <button
                          class="thumb"
                          data-gallery={p.slug}
                          data-index={idx + 1}
                          aria-label={img.caption}
                        >
                          <img src={url(img.src)} alt={img.caption} loading="lazy" />
                        </button>
                      ))}
                    </div>
                  )}
                </>
              )}
            </div>

            <div class="info">
              <span class="tipo">{p.tipo}</span>
              <h3>{p.titulo}</h3>
              <p class="desc">{p.descripcion}</p>

              <ul class="destacados">
                {p.destacados.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>

              <div class="tags">
                {p.tecnologias.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>

              <div class="acciones">
                <a href={p.repo} target="_blank" rel="noopener" class="btn-link primary">
                  Ver código →
                </a>
                {p.demo && (
                  <a href={p.demo} target="_blank" rel="noopener" class="btn-link">
                    Demo en vivo ↗
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- Lightbox -->
<div class="lb" id="lightbox" hidden>
  <button class="lb-close" id="lb-close" aria-label="Cerrar">✕</button>
  <button class="lb-nav lb-prev" id="lb-prev" aria-label="Anterior">‹</button>
  <figure class="lb-fig">
    <img id="lb-img" src="" alt="" />
    <figcaption id="lb-cap"></figcaption>
  </figure>
  <button class="lb-nav lb-next" id="lb-next" aria-label="Siguiente">›</button>
</div>

<script is:inline set:html={`window.__galerias = ${JSON.stringify(galerias)};`}></script>

<style>
  .list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .proj {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 2rem;
    align-items: start;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 1.5rem;
    box-shadow: var(--shadow);
  }
  .proj.flip .gallery {
    order: 2;
  }
  .info {
    align-self: center;
  }

  /* Galería */
  .cover {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    border-radius: 16px;
    overflow: hidden;
    cursor: pointer;
    position: relative;
    background: var(--bg-soft);
    aspect-ratio: 16 / 9;
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .cover:hover img {
    transform: scale(1.04);
  }
  .cover-cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.4rem 1rem 0.7rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: #fff;
    text-align: left;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.75));
  }
  .thumbs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(70px, 1fr));
    gap: 0.55rem;
    margin-top: 0.7rem;
  }
  .thumb {
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    aspect-ratio: 1;
    background: var(--bg-soft);
    transition: transform 0.15s, border-color 0.2s;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }
  .placeholder {
    width: 100%;
    aspect-ratio: 16 / 9;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.4rem;
    border-radius: 16px;
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 18%, var(--bg-soft)), color-mix(in srgb, var(--accent-3) 18%, var(--bg-soft)));
    border: 2px dashed var(--border);
  }
  .ph-ico {
    font-size: 2.4rem;
  }
  .ph-txt {
    font-weight: 600;
    color: var(--text-soft);
  }

  /* Info */
  .tipo {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    margin-bottom: 0.7rem;
  }
  h3 {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 0.6rem;
  }
  .desc {
    color: var(--text-soft);
    margin-bottom: 1rem;
  }
  .destacados {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.1rem;
  }
  .destacados li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 0.92rem;
    color: var(--text-soft);
  }
  .destacados li::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.3rem;
  }
  .tag {
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.3rem 0.7rem;
    border-radius: 8px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    color: var(--text-soft);
  }
  .acciones {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
  .btn-link {
    font-weight: 600;
    padding: 0.6rem 1.2rem;
    border-radius: 12px;
    border: 1px solid var(--border);
    transition: transform 0.15s, border-color 0.2s;
  }
  .btn-link.primary {
    color: #fff;
    background: var(--gradient);
    border: none;
  }
  .btn-link:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }

  @media (max-width: 820px) {
    .proj {
      grid-template-columns: 1fr;
    }
    .proj.flip .gallery {
      order: 0;
    }
  }

  /* Lightbox */
  .lb {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.5rem;
    background: rgba(3, 6, 16, 0.9);
    backdrop-filter: blur(6px);
    animation: fade 0.2s ease;
  }
  .lb[hidden] {
    display: none;
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  .lb-fig {
    max-width: min(1100px, 90vw);
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }
  .lb-fig img {
    max-width: 100%;
    max-height: 78vh;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.8);
  }
  .lb-fig figcaption {
    color: #e8ecf6;
    font-size: 0.95rem;
    text-align: center;
    max-width: 60ch;
  }
  .lb-close {
    position: absolute;
    top: 1rem;
    right: 1.2rem;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-size: 1.1rem;
    cursor: pointer;
    transition: background 0.2s;
  }
  .lb-nav {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.2s;
  }
  .lb-close:hover,
  .lb-nav:hover {
    background: rgba(255, 255, 255, 0.28);
  }
  @media (max-width: 620px) {
    .lb-nav {
      width: 42px;
      height: 42px;
      font-size: 1.5rem;
    }
  }
</style>

<script>
  const lb = document.getElementById('lightbox') as HTMLElement;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement;
  const lbCap = document.getElementById('lb-cap') as HTMLElement;
  const galerias = (window as any).__galerias as Record<string, { src: string; caption: string }[]>;

  let actual: { src: string; caption: string }[] = [];
  let idx = 0;

  function render() {
    const item = actual[idx];
    if (!item) return;
    lbImg.src = item.src;
    lbImg.alt = item.caption;
    lbCap.textContent = `${item.caption}  ·  ${idx + 1}/${actual.length}`;
  }
  function abrir(slug: string, i: number) {
    actual = galerias[slug] || [];
    idx = i;
    render();
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
  }
  function cerrar() {
    lb.hidden = true;
    document.body.style.overflow = '';
  }
  function mover(paso: number) {
    idx = (idx + paso + actual.length) % actual.length;
    render();
  }

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((el) => {
    el.addEventListener('click', () =>
      abrir(el.dataset.gallery!, Number(el.dataset.index || 0))
    );
  });
  document.getElementById('lb-close')?.addEventListener('click', cerrar);
  document.getElementById('lb-prev')?.addEventListener('click', () => mover(-1));
  document.getElementById('lb-next')?.addEventListener('click', () => mover(1));
  lb.addEventListener('click', (e) => {
    if (e.target === lb) cerrar();
  });
  document.addEventListener('keydown', (e) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') cerrar();
    if (e.key === 'ArrowLeft') mover(-1);
    if (e.key === 'ArrowRight') mover(1);
  });
</script>
