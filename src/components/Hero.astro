---
import { perfil } from '../data/portfolio';
---

<section id="inicio" class="hero">
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>
  <div class="blob blob-3"></div>

  <div class="container hero-inner">
    <p class="eyebrow reveal">👋 Hola, soy</p>
    <h1 class="reveal">{perfil.nombre}</h1>
    <h2 class="role reveal">{perfil.rol}</h2>
    <p class="tagline reveal">{perfil.subtitulo}</p>
    <p class="loc reveal">📍 {perfil.ubicacion}</p>

    <div class="cta reveal">
      <a href="#proyectos" class="btn btn-primary">Ver proyectos</a>
      <a href="#contacto" class="btn btn-ghost">Contacto</a>
    </div>

    <div class="socials reveal">
      <a href={perfil.links.github} target="_blank" rel="noopener">GitHub</a>
      <span>·</span>
      <a href={perfil.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <span>·</span>
      <a href={`mailto:${perfil.email}`}>Email</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 64px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    text-align: center;
  }
  .eyebrow {
    color: var(--text-soft);
    font-weight: 600;
    letter-spacing: 0.02em;
    margin-bottom: 0.6rem;
  }
  h1 {
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .role {
    font-size: clamp(1.2rem, 3.5vw, 2rem);
    font-weight: 700;
    margin-top: 0.6rem;
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .tagline {
    color: var(--text-soft);
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    margin-top: 0.8rem;
  }
  .loc {
    color: var(--text-faint);
    margin-top: 0.4rem;
    font-size: 0.95rem;
  }
  .cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-top: 2rem;
    flex-wrap: wrap;
  }
  .btn {
    padding: 0.85rem 1.7rem;
    border-radius: 14px;
    font-weight: 600;
    transition: transform 0.15s, box-shadow 0.2s;
  }
  .btn-primary {
    color: #fff;
    background: var(--gradient);
    box-shadow: 0 12px 24px -10px var(--accent);
  }
  .btn-ghost {
    border: 1px solid var(--border);
    background: var(--bg-elev);
  }
  .btn:hover {
    transform: translateY(-3px);
  }
  .socials {
    margin-top: 1.6rem;
    display: flex;
    gap: 0.8rem;
    justify-content: center;
    color: var(--text-faint);
    font-weight: 500;
  }
  .socials a {
    color: var(--text-soft);
    transition: color 0.2s;
  }
  .socials a:hover {
    color: var(--accent);
  }

  /* Blobs decorativos animados */
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
    z-index: 1;
    animation: float 14s ease-in-out infinite;
  }
  .blob-1 {
    width: 380px;
    height: 380px;
    background: #6366f1;
    top: -80px;
    left: -60px;
  }
  .blob-2 {
    width: 340px;
    height: 340px;
    background: #ec4899;
    bottom: -60px;
    right: -40px;
    animation-delay: -4s;
  }
  .blob-3 {
    width: 300px;
    height: 300px;
    background: #a855f7;
    top: 40%;
    left: 55%;
    animation-delay: -8s;
  }
  :root[data-theme='dark'] .blob {
    opacity: 0.32;
  }
  @keyframes float {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(30px, -30px) scale(1.08);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .blob {
      animation: none;
    }
  }
</style>
