---
import { perfil } from '../data/portfolio';
const anio = new Date().getFullYear();
---

<section id="contacto" class="contact">
  <div class="blob"></div>
  <div class="container inner">
    <h2 class="section-title reveal">¿Trabajamos <span class="accent">juntos?</span></h2>
    <p class="lead reveal">
      Estoy abierto a nuevas oportunidades y colaboraciones. Escríbeme y conversamos.
    </p>

    <div class="channels reveal">
      <a href={`mailto:${perfil.email}`} class="channel">
        <span class="c-ico">✉️</span>
        <span class="c-label">Email</span>
        <span class="c-val">{perfil.email}</span>
      </a>
      <a href={perfil.links.linkedin} target="_blank" rel="noopener" class="channel">
        <span class="c-ico">💼</span>
        <span class="c-label">LinkedIn</span>
        <span class="c-val">Jubert Goya</span>
      </a>
      <a href={perfil.links.github} target="_blank" rel="noopener" class="channel">
        <span class="c-ico">💻</span>
        <span class="c-label">GitHub</span>
        <span class="c-val">Jagr-ecu</span>
      </a>
    </div>
  </div>

  <footer class="foot">
    <div class="container">
      <span>© {anio} {perfil.nombre}</span>
      <span>Hecho con Astro · Desplegado en GitHub Pages</span>
    </div>
  </footer>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    padding-bottom: 0;
  }
  .inner {
    text-align: center;
    position: relative;
    z-index: 2;
  }
  .lead {
    color: var(--text-soft);
    font-size: 1.1rem;
    max-width: 45ch;
    margin: 0 auto 2.5rem;
  }
  .channels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.2rem;
    max-width: 760px;
    margin: 0 auto;
  }
  .channel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    padding: 1.6rem 1rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 18px;
    box-shadow: var(--shadow);
    transition: transform 0.18s, border-color 0.2s;
  }
  .channel:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }
  .c-ico {
    font-size: 1.8rem;
  }
  .c-label {
    font-weight: 700;
  }
  .c-val {
    font-size: 0.85rem;
    color: var(--text-faint);
    word-break: break-all;
  }
  .blob {
    position: absolute;
    width: 460px;
    height: 460px;
    border-radius: 50%;
    background: var(--accent-2);
    filter: blur(90px);
    opacity: 0.22;
    top: -160px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
  }
  .foot {
    margin-top: 4rem;
    border-top: 1px solid var(--border);
    padding: 1.5rem 0;
  }
  .foot .container {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    color: var(--text-faint);
    font-size: 0.85rem;
  }
</style>
